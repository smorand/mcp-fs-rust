# Self-contained local config template: SQLite metadata + local (filesystem) blobs + SQLite ACL.
# No external service required. This is the recommended default on Windows.
# Copy to config/local.yaml:
#   cp config/local.yaml.template config/local.yaml

server:
  host: 0.0.0.0
  port: 5002
  mcp_path: /mcp

auth:
  jwt:
    public_key_path: .keys/jwt.pub
    header: X-Forwarded-Authorization
    algorithms: [RS256]
    issuer: web-a2a
    username_claim: email
  admins:
    - admin@example.com

infra:
  meta:
    backend: sqlite
    dir: state/volumes
  blob:
    backend: local
    dir: state/blobs
  admin:
    backend: sqlite
    path: state/admin.db

safety:
  write_quota_bytes: 52428800
  trash_dir: .mcp_trash
  read_guard: true
  allow_hard_delete: false
  max_read_lines: 2000

# The /api/fs REST data plane (upload/download/browse/zip + tool parity). Set false for MCP-only.
api:
  enabled: true

extract:
  ocr:
    provider: none
    # To enable image understanding, point this at a multimodal endpoint:
    # provider: multimodal
    # endpoint: https://api.openai.com/v1/chat/completions
    # model: gpt-4o-mini
    # api_key_env: MCP_FS_OCR_KEY
    # prompt: "Transcribe this document faithfully into Markdown."

# External document to Markdown converter (opt-in), used by the
# trigger_documentation_service flag on byte uploads and by fs.documentize.
# PowerPoint, Word, PDF, audio and video only. Off by default.
# doc_service:
#   enabled: false
#   mode: cli                      # cli | api
#   extensions: []                 # empty = the built-in eligible set
#   max_input_bytes: 536870912     # 512 MiB
#   # cli mode: an argv list, never a shell string. Exactly one {document}
#   # placeholder, expanded to a relative name inside a per-call sandbox. Wrap
#   # argv[0] in sandbox-exec / bwrap / docker run for real OS containment.
#   cli:
#     command: ["doc-convert", "--stdout", "--quiet", "{document}"]
#     timeout_secs: 900
#   # api mode: POST multipart/form-data, Markdown back.
#   api:
#     url: ""
#     auth_header: Authorization   # header NAME, not necessarily a bearer
#     auth_token: "${MCPFS_DOC_SERVICE_TOKEN}"   # secret, sent verbatim
#     file_field: file             # name of the multipart part carrying the document
#     response_field: ""           # empty = the response body IS the markdown
#     timeout_secs: 900

# Git HTTP smart server (opt-in). When enabled, adds git.* MCP tools and
# HTTP endpoints at /git/{mount_id}/info/refs etc.
git:
  enabled: false
  object_format: sha1
  anonymous_read: false
  max_pack_size_mb: 512
