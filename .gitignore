# Rust build output
/target
**/target

# Runtime state (SQLite metadata, local blobs, admin db, git, oauth, trash)
state/

# Dev signing keys (generate with `mcp-fs keys`)
.keys/

# Local secrets sourced by run.sh -- never commit real secrets
.env

# Local-only config (personal working copy; copy from a *.yaml.template)
config/local.yaml

# Logs
*.log

# IDE
.idea/
.vscode/

# Per user JWT files consumed by ./agent.sh (one raw token per file). Never commit.
.agent_keys/
# Conversation transcripts and readline history from ./agent.sh.
.agent_history/
# Server logs written by ./agent.sh when it starts the server itself.
mcp_*.log
# Byte cache from importing scripts/pty_check.py as a module.
__pycache__/
