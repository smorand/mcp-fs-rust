# mcp-fs local secrets -- copy to .env and fill in. .env is gitignored.
# run.sh sources .env automatically.

# MinIO / S3 blob backend (config/minio.yaml.template uses ${MCPFS_MINIO_SECRET_KEY})
MCPFS_MINIO_ENDPOINT=http://127.0.0.1:9000
MCPFS_MINIO_ACCESS_KEY=admin
MCPFS_MINIO_SECRET_KEY=

# GitHub App device flow (git.auth provider=github)
MCPFS_GITHUB_CLIENT_SECRET=

# OAuth token persistence (optional). If unset, tokens are in-memory only.
# Generate with: openssl rand -base64 32
MCPFS_TOKEN_KEY=
